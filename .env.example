# Copy to .env and adjust. .env is git-ignored — never commit real credentials.

# Port for the API server (and, in production, the whole site).
PORT=4000

# MongoDB connection string (e.g. MongoDB Atlas: mongodb+srv://user:password@cluster.../?appName=...).
MONGODB_URI=
# Database name inside the cluster (created automatically on first start).
MONGODB_DB=ihe

# Cloudinary — stores every image uploaded in the admin panel.
# Console → Settings → API Keys. Never commit or share the API secret.
# Leave all three empty to disable uploads (the rest of the site still works).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary media library (sub-folders: blogs, hero, projects, services, certificates, branding, avatars).
CLOUDINARY_FOLDER=ihe

# First super admin — created only when the database has no admin users yet.
# Use a strong password (10+ characters, letters and numbers). After the first
# start you can remove ADMIN_PASSWORD from .env; change it later in Settings → Security.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin@1234

# Days a sign-in stays valid without activity.
SESSION_TTL_DAYS=7

# Extra origins allowed to send write requests (comma-separated). Only needed if
# the frontend is served from a different domain than the API.
ALLOWED_ORIGINS=

# Set to "production" when deploying (enables Secure cookies).
NODE_ENV=development
